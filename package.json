{
  "name": "handwerk-quote-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Synthetic internal vertical slice for the Handwerk Quote Copilot",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @handwerk/web run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm --workspace @handwerk/e2e run test",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "file-type": "21.3.4",
    "lucide-react": "0.468.0",
    "papaparse": "5.5.3",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "zod": "3.25.76"
  }
}
