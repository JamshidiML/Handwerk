# Local synthetic-data environment only. Replace every change-me value outside local/demo use.
HANDWERK_ENV=development
DEMO_MODE=true
AI_PROVIDER=deterministic_fake
ENABLE_LIVE_AI=false
LOG_LEVEL=info
TELEMETRY_MODE=local
PORT=3000

POSTGRES_DB=handwerk
POSTGRES_USER=handwerk
POSTGRES_PASSWORD=local-development-only-change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://handwerk:local-development-only-change-me@127.0.0.1:5432/handwerk

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=eu-central-1
OBJECT_STORAGE_BUCKET=handwerk-synthetic
OBJECT_STORAGE_ACCESS_KEY=handwerk-local
OBJECT_STORAGE_SECRET_KEY=local-development-only-change-me
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001
