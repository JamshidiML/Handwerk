{
  "name": "@handwerk/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@handwerk/contracts": "0.1.0",
    "@handwerk/domain": "0.1.0",
    "pg": "8.16.3"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "node --import tsx src/cli/migrate.ts",
    "db:seed": "node --import tsx src/cli/seed.ts"
  }
}
