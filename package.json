{
  "name": "handwerk-quote-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic internal vertical slice for the Handwerk Quote Copilot",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.0.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "setup": "node scripts/platform.mjs setup",
    "env:init": "node scripts/platform.mjs env-init",
    "env:check": "node --env-file-if-exists=.env --import tsx packages/observability/src/cli/config-check.ts",
    "services:up": "node scripts/platform.mjs services-up",
    "services:down": "node scripts/platform.mjs services-down",
    "services:status": "node scripts/platform.mjs services-status",
    "health": "node --env-file-if-exists=.env --import tsx packages/observability/src/cli/healthcheck.ts",
    "dev": "node scripts/platform.mjs npm --workspace @handwerk/web run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint:shared && npm run lint:web",
    "lint:shared": "eslint packages scripts vitest.config.ts",
    "lint:web": "npm --workspace @handwerk/web run lint",
    "test": "npm run build && npm run test --workspaces --if-present && npm run test:platform",
    "test:platform": "vitest run --config vitest.config.ts scripts/tests",
    "test:unit": "npm run test:unit --workspaces --if-present && npm run test:platform",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "node scripts/platform.mjs npm run test:e2e --workspaces --if-present",
    "db:migrate": "node scripts/platform.mjs npm run db:migrate --workspaces --if-present",
    "db:seed": "node scripts/platform.mjs npm run db:seed --workspaces --if-present",
    "db:migration:check": "node scripts/platform.mjs migration-check",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "security:audit": "node scripts/dependency-audit.mjs",
    "security:audit:raw": "npm audit --audit-level=high",
    "security:inventory": "node scripts/dependency-inventory.mjs --output .artifacts/dependency-inventory.json",
    "security:sbom": "node scripts/dependency-inventory.mjs --sbom .artifacts/sbom.cdx.json",
    "ci:quality": "npm run format:check && npm run lint && npm run typecheck",
    "ci:test": "npm run test:unit && npm run test:integration && npm run build",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "file-type": "21.3.4",
    "lucide-react": "0.468.0",
    "papaparse": "5.5.3",
    "pdf-lib": "1.17.1",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "overrides": {
    "brace-expansion": "2.1.4",
    "vite": "8.2.1",
    "@handwerk/web": {
      "@cloudflare/vite-plugin": "1.51.3",
      "@cloudflare/workers-types": "5.20260804.1",
      "wrangler": "4.121.0"
    }
  }
}
